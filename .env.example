# FAP-Core Main API Configuration
FAP_ENV=development
FAP_API_KEY=your-secure-api-key-here
FAP_RATE_LIMIT=100/minute

# FAP-Insurance Configuration
FAP_CORE_URL=http://localhost:8000

# Notes:
# - FAP_API_KEY: Required in production. Generate a strong random string.
# - FAP_CORE_URL: Point to your FAP-Core deployment (production vs. staging).
# - FAP_ENV: Set to 'production' in prod, 'development' locally.
#
# To use:
# 1. Copy this file to .env (in local dev only)
# 2. Fill in real values
# 3. Add .env to .gitignore (already done)
# 4. Load with: source .env (bash) or export $(cat .env | xargs)
